# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your production/local secrets.
# DO NOT COMMIT THE .env FILE TO GIT.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:mysql://mysql-db:3306/snd_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Dhaka&characterEncoding=UTF-8
DB_USERNAME=snd_user
DB_PASSWORD=your_database_password

# CORS Allowed Origins
CORS_ALLOWED_URLS=http://localhost:3201

# SMS Gateway Credentials
APP_SMS_BASE_URL=https://isms.digitalsquare.ltd:5684/sendtext
APP_SMS_API_KEY=your_sms_api_key
APP_SMS_SECRET_KEY=your_sms_secret_key
APP_SMS_CALLER_ID=8809643901704

# SMTP Mail Server Credentials
SPRING_MAIL_HOST=mail.ainext.site
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=snd@ainext.site
SPRING_MAIL_PASSWORD=your_smtp_password
APP_MAIL_FROM=snd@ainext.site
APP_MAIL_FROM_NAME=IPTSP Recharge Distribution